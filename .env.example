# ============================================================
# VeroRun — .env 模板（Docker Compose / 企业部署）
# ------------------------------------------------------------
# 用法:
#   cp .env.example .env
#   然后生成密钥并填写（见下方「生成密钥」）。
# 切勿提交 .env 到 git（已在 .gitignore 中排除）。
# 字段与 deploy/mac-mini-deploy.sh ensure_env() 生成的内容一致。
# ============================================================

# ── 部署市场与类型 ──────────────────────────────────────
# 市场: cn（国内）| global（海外）
DEPLOY_MARKET=cn
# 部署版本（阶段 3）：standard / pro / edu / minipro；商店按 compatible_editions 过滤插件
DEPLOY_EDITION=standard
# 阶段 3：国内服务器商店目录多源（Gitee 优先，GitHub 回退）与下载镜像
# STORE_CATALOG_URLS=https://gitee.com/fanjumin/verorun-store/raw/main/store_catalog.json,https://raw.githubusercontent.com/fanjumin/verorun-store/main/store_catalog.json
# DOWNLOAD_MIRROR_PREFIX=https://gitee.com/fanjumin/verorun-store/raw/main
# 部署类型/环境（Docker 部署建议 production）
DEPLOY_TYPE=production
DEPLOY_ENV=production
# 对外域名（无则留空，纯 HTTP；有证书则自动启用 HTTPS）
DEPLOY_DOMAIN=
DEPLOY_PROTOCOL=http

# ── PostgreSQL 主库 ─────────────────────────────────────
# Docker Compose 下固定走服务名 db / postgres_miniapp
DB_PATH=/app/data/x7k2m9a4.db
PG_HOST=db
PG_PORT=5432
PG_DB=appdb
PG_USER=app
# 生成密钥: openssl rand -hex 32
PG_PASSWORD=

# ── 认证与加密密钥（全部必填，生成密钥: openssl rand -hex 32） ──
JWT_SECRET=
FLASK_SECRET_KEY=
ENCRYPTION_KEY=
PLUGIN_LICENSE_SECRET=
CAPTCHA_SECRET_KEY=
DEV_ACCOUNTS_ENCRYPTION_KEY=
LICENSE_SERVER_SECRET=
PROBE_SECRET=
HEALTH_SECRET=
# 内部服务间通信 token
INTERNAL_SERVICE_TOKEN=

# ── 运行模式 ────────────────────────────────────────────
# main（主服务器）| client（独立部署客户端）
APP_MODE=main
APP_DEBUG=false
FLASK_DEBUG=0
# 管理后台基础认证开关
ADMIN_BASIC_AUTH=0
ADMIN_BASIC_AUTH_USER=admin
NGINX_SNIPPETS_DIR=/etc/nginx/sites-enabled
MAIN_SITE_INTERNAL_URL=http://127.0.0.1:8083
# 插件自动安装
PLUGIN_AUTO_INSTALL=0

# ── VeroGuard 守护进程 ──────────────────────────────────
# 远程上报端点：
#   - 留空          → 按 APP_REGION 回退到官方默认地址（cn: api.verorun.cn / 其他: api.verorun.com）
#   - off|disabled  → 完全离线，心跳上报被跳过（企业隐私场景）
GUARDIAN_REMOTE_URL=
# 部署码（官方授权下发，可留空）
DEPLOYMENT_CODE=

# ── AI 服务密钥（按需填写，留空则相关功能不可用） ──
DASHSCOPE_TEXT_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ── 区域 ────────────────────────────────────────────────
APP_REGION=cn

# ── mini_app_builder 插件独立库 ─────────────────────────
MINI_APP_PG_USER=app
# 生成密钥: openssl rand -hex 32
MINI_APP_PG_PASSWORD=
