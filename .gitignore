# ── 运行时生成的加解密盐（auth-center/services/crypto.py 首次调用时落盘）──
# 二进制、每台机器不同、泄漏即等于泄漏加密凭据 —— 永不入库。
auth-center/services/.crypto_salt
# 持久盐路径（SB-BUG-1 修复后 crypto.py 默认落盘 data/.crypto_salt，跨部署存活）
data/.crypto_salt

# ── 本地 SSH 远程运维/测试脚本（含服务器地址与用户名，仅本机使用，永不入库）──
/_ssh/
