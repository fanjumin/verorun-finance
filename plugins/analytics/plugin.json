{
  "name": "Analytics",
  "name_i18n_key": "plugin.name",
  "identifier": "analytics",
  "python_dependencies": {
    "required": [
      "user-agents"
    ],
    "optional": {}
  },
  "version": "1.9.2",
  "description": "Analytics Middleware & Dashboard — Server-side Cookieless Analytics",
  "author": "VeroRun",
  "min_app_version": "0.10.0",
  "category": "system",
  "icon": "analytics",
  "icon_url": "",
  "tags": [
    "analytics",
    "statistics",
    "traffic",
    "monitoring"
  ],
  "screenshots": [],
  "readme_url": "",
  "dependencies": {},
  "admin_url": "",
  "admin_label": "Analytics Settings",
  "config": {
    "sample_rate": 1.0,
    "geoip_enabled": true,
    "service_name": "admin"
  },
  "permissions": [
    "api:read",
    "api:write",
    "network:request"
  ],
  "admin_permissions": [
    "admin:access"
  ],
  "hooks": {
    "provides": [
      "analytics/track_event",
      "analytics/get_realtime",
      "analytics/get_trend"
    ],
    "listens": []
  },
  "menu": {
    "group": "Monitoring & Data",
    "key": "analytics",
    "icon": "analytics",
    "label": "Analytics"
  },
  "dashboard": {
    "stats": [
      {
        "key": "today_pv",
        "title": "今日 PV",
        "type": "counter"
      },
      {
        "key": "today_uv",
        "title": "今日 UV",
        "type": "counter"
      },
      {
        "key": "online_now",
        "title": "实时在线",
        "type": "counter"
      },
      {
        "key": "total_pv_30d",
        "title": "30 日 PV",
        "type": "counter"
      }
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "sample_rate": {
        "type": "number",
        "default": 1.0,
        "minimum": 0.0,
        "maximum": 1.0,
        "description": "Sampling rate for request capture"
      },
      "geoip_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Enable GeoIP location lookup"
      },
      "service_name": {
        "type": "string",
        "default": "admin",
        "description": "Service name label for analytics logs"
      },
      "maxmind_account_id": {
        "type": "string",
        "default": "",
        "description": "MaxMind Account ID for GeoLite2 download"
      },
      "maxmind_license_key": {
        "type": "string",
        "format": "password",
        "writeOnly": true,
        "default": "",
        "description": "MaxMind License Key for GeoLite2 download"
      }
    }
  }
}
