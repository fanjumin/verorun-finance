        "type": "counter"
      },
      {
        "key": "total_contacts",
        "title": "Contacts",
        "type": "counter"
      }
    ]
  },
  "menu": {
    "group": "Users & Support",
    "key": "email",
    "icon": "email",
    "label": "Email Management"
