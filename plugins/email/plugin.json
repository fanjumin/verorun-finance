{
  "name": "Email Service",
  "name_i18n_key": "plugin.name",
  "identifier": "email",
  "python_dependencies": {
    "required": [],
    "optional": {}
  },
  "version": "1.8.0",
  "category": "system",
  "tags": [
    "email",
    "smtp",
    "imap",
    "notification"
  ],
  "icon": "email",
  "icon_url": "",
  "screenshots": [],
  "readme_url": "",
  "description": "Email Service — SMTP/IMAP email client with inbox, compose, attachments, and contact management",
  "author": "VeroRun",
  "min_app_version": "0.10.0",
  "compatible_editions": ["enterprise", "standard", "pro", "finance", "research", "minipro"],
  "agent_role": "service",
"capabilities": [
    "email.send",
    "email.template"
  ],
  "dependencies": {},
  "admin_url": "",
  "admin_label": "Email Settings",
  "config": {
    "smtp_host": "",
    "smtp_port": 0,
    "smtp_user": "",
    "smtp_pass": "",
    "smtp_from": "",
    "imap_host": "",
    "imap_port": 0,
    "alert_recipient": "",
    "blocked_attachment_exts": ".exe,.bat,.cmd,.scr,.js,.vbs,.ps1,.jar,.msi",
    "allow_private_targets": false,
    "daily_send_quota": 200,
    "recipient_domain_allowlist": ""
  },
  "permissions": [
    "network:request",
    "api:read",
    "api:write",
    "events"
  ],
  "hooks": {
    "provides": [
      "email/send",
      "email/send_contact",
      "email/get_config"
    ],
    "listens": [
      "stock.alert.triggered",
      "stock.morning_brief.ready"
    ]
  },
  "dashboard": {
    "stats": [
      {
        "key": "total_sent",
        "title": "Emails Sent",
        "type": "counter"
      },
      {
        "key": "total_contacts",
        "title": "Contacts",
        "type": "counter"
      }
    ]
  },
  "menu": {
    "group": "Users & Support",
    "key": "email",
    "icon": "email",
    "label": "Email Management"
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "smtp_host": {
        "type": "string",
        "default": "",
        "description": "SMTP server hostname"
      },
      "smtp_port": {
        "type": "integer",
        "default": 0,
        "description": "SMTP port"
      },
      "smtp_user": {
        "type": "string",
        "default": "",
        "description": "SMTP username"
      },
      "smtp_pass": {
        "type": "string",
        "default": "",
        "description": "SMTP password (sensitive)"
      },
      "smtp_from": {
        "type": "string",
        "default": "",
        "description": "From address"
      },
      "imap_host": {
        "type": "string",
        "default": "",
        "description": "IMAP server hostname"
      },
      "imap_port": {
        "type": "integer",
        "default": 0,
        "description": "IMAP port"
      },
      "alert_recipient": {
        "type": "string",
        "default": "",
        "description": "Stock alert recipient address (empty = email channel skipped); env ALERT_RECIPIENT overrides"
      },
      "blocked_attachment_exts": {
        "type": "string",
        "default": ".exe,.bat,.cmd,.scr,.js,.vbs,.ps1,.jar,.msi",
        "description": "Blocked attachment extensions, comma separated (empty = allow all)"
      },
      "allow_private_targets": {
        "type": "boolean",
        "default": false,
        "description": "Allow test-config to probe loopback/private SMTP/IMAP targets (default: blocked)"
      },
      "daily_send_quota": {
        "type": "integer",
        "default": 200,
        "description": "Max emails sent per day (0 = unlimited); counted from email_sent records"
      },
      "recipient_domain_allowlist": {
        "type": "string",
        "default": "",
        "description": "Allowed recipient domains, comma separated (empty = allow all)"
      }
    }
  }
}
