      },
      "smtp_port": {
        "type": "integer",
        "default": 0,
        "description": "SMTP port"
      },
      "smtp_user": {
        "type": "string",
        "default": "",
        "description": "SMTP username"
      },
      "smtp_pass": {
        "type": "string",
        "default": "",
        "description": "SMTP password (sensitive)"
      },
      "smtp_from": {
        "type": "string",
        "default": "",
        "description": "From address"
      },
      "imap_host": {
        "type": "string",
        "default": "",
        "description": "IMAP server hostname"
      },
      "imap_port": {
        "type": "integer",
        "default": 0,
        "description": "IMAP port"
      }
