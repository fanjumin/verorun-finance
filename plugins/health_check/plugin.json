{
  "name": "Health Check",
  "name_i18n_key": "plugin.name",
  "identifier": "health_check",
  "python_dependencies": {
    "required": [
      "redis"
    ],
    "optional": {}
  },
  "version": "1.11.2",
  "description": "System Health Check — Automated health monitoring + alerting + trend analysis",
  "tagline": "系统健康自动巡检",
  "tagline_subtitle": "CPU/内存/磁盘监控 · 告警通知 · 趋势分析",
  "author": "VeroRun",
  "min_app_version": "0.10.0",
  "compatible_editions": ["enterprise", "standard", "pro", "finance", "minipro"],
  "category": "system",
  "icon": "health",
  "icon_url": "",
  "tags": [
    "health",
    "monitoring",
    "alerting"
  ],
  "screenshots": [],
  "readme_url": "",
  "dependencies": {},
  "config": {},
  "permissions": [
    "api:read",
    "api:write",
    "network:request"
  ],
  "hooks": {
    "provides": [
      "health/run_check",
      "health/get_status",
      "health/get_trend"
    ],
    "listens": []
  },
  "agent_role": "ops",
  "capabilities": [
    "health_analysis",
    "fix_suggestion",
    "root_cause_analysis"
  ],
  "dashboard": {
    "stats": [
      {
        "key": "health_score",
        "title": "Health Score",
        "type": "gauge"
      },
      {
        "key": "health_passed",
        "title": "Passed",
        "type": "counter"
      },
      {
        "key": "health_warnings",
        "title": "Warnings",
        "type": "counter"
      },
      {
        "key": "health_errors",
        "title": "Errors",
        "type": "counter"
      },
      {
        "key": "unread_alerts",
        "title": "Unread Alerts",
        "type": "counter"
      }
    ]
  },
  "menu": {
    "group": "Monitoring & Data",
    "key": "health",
    "icon": "health",
    "label": "Health Check"
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "alert_email": {
        "type": "string",
        "description": "Admin email for health alerts"
      },
      "webhook_url": {
        "type": "string",
        "description": "Webhook URL for external alert notifications"
      },
      "check_interval_minutes": {
        "type": "integer",
        "default": 5,
        "description": "Automatic health check interval in minutes"
      },
      "cpu_threshold": {
        "type": "integer",
        "default": 90,
        "description": "CPU usage alert threshold (%)"
      },
      "mem_threshold": {
        "type": "integer",
        "default": 85,
        "description": "Memory usage alert threshold (%)"
      },
      "disk_threshold": {
        "type": "integer",
        "default": 85,
        "description": "Disk usage alert threshold (%)"
      }
    }
  }
}
