  "capabilities": [
    "review.validate",
    "review.moderation",
    "review.analyze"
  ],
  "category": "shop",
  "icon": "star",
  "tags": [
    "review",
    "rating",
    "ecommerce"
  ],
  "dependencies": {},
  "config": {},
