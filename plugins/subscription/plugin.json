{
  "name": "Subscription",
  "name_i18n_key": "plugin.name",
  "identifier": "subscription",
  "python_dependencies": {
    "required": [
      "defusedxml"
    ],
    "optional": {}
  },
  "version": "2.5.3",
  "description": "Unified Subscription Management — Pay-as-you-go feature marketplace with dual-environment payment routing (cn: Alipay/WeChat, intl: Stripe/PayPal)",
  "author": "VeroRun",
  "min_app_version": "0.10.0",
  "agent_role": "finance",
  "capabilities": [
    "subscription.list",
    "subscription.subscribe",
    "subscription.cancel",
    "subscription.renew",
    "subscription.check_access"
  ],
  "category": "system",
  "icon": "credit_card",
  "icon_url": "",
  "readme_url": "",
  "screenshots": [
    "screenshots/admin.png"
  ],
  "tags": [
    "subscription",
    "payment",
    "billing"
  ],
  "dependencies": {},
  "enabled": true,
  "admin_url": "",
  "admin_label": "Subscription Settings",
  "menu": {
    "group": "Business Center",
    "items": [
      {
        "key": "subscription_admin",
        "icon": "credit_card",
        "label": "Subscription"
      }
    ]
  },
  "dashboard": {
    "stats": [
      {
        "key": "active_subscriptions",
        "title": "活跃订阅",
        "type": "counter"
      },
      {
        "key": "total_plans",
        "title": "订阅方案",
        "type": "counter"
      },
      {
        "key": "total_revenue_fen",
        "title": "累计收入(分)",
        "type": "counter"
      }
    ]
  },
  "config": {
    "trial_days": 0,
    "grace_days": 3,
    "auto_renew_default": true
  },
  "permissions": [
    "api:read",
    "api:write",
    "admin:access"
  ],
  "hooks": {
    "provides": [
      "subscription/has",
      "subscription/list",
      "subscription/subscribe",
      "subscription/cancel",
      "subscription/renew",
      "subscription/check_module_access",
      "subscription/site_plans"
    ],
    "listens": []
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "trial_days": {
        "type": "integer",
        "default": 0,
        "minimum": 0,
        "description": "Free trial period in days (0 = no trial)"
      },
      "grace_days": {
        "type": "integer",
        "default": 3,
        "minimum": 0,
        "description": "Grace period after expiration before disabling"
      },
      "auto_renew_default": {
        "type": "boolean",
        "default": true,
        "description": "Default auto-renew for new subscriptions"
      }
    }
  }
}
