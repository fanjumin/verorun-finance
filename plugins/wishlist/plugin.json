{
  "name": "Wishlist",
  "name_i18n_key": "plugin.name",
  "identifier": "wishlist",
  "python_dependencies": {
    "required": [],
    "optional": {}
  },
  "version": "1.7.3",
  "description": "收藏/心愿单 — 用户收藏商品、管理心愿清单",
  "tagline": "商品收藏与心愿清单",
  "tagline_subtitle": "收藏/取消 · 列表管理 · 跨端同步",
  "author": "VeroRun",
  "min_app_version": "0.10.0",
  "compatible_editions": ["enterprise", "standard", "pro", "finance", "minipro"],
  "agent_role": "business",
  "capabilities": [
    "wishlist.add",
    "wishlist.remove",
    "wishlist.list",
    "wishlist.sync"
  ],
  "category": "shop",
  "icon": "heart",
  "icon_url": "",
  "screenshots": [],
  "readme_url": "",
  "tags": [
    "wishlist",
    "favorites",
    "ecommerce"
  ],
  "dependencies": {},
  "enabled": true,
  "config": {},
  "permissions": [
    "api:read",
    "user:profile"
  ],
  "hooks": {
    "provides": [
      "wishlist/sync"
    ],
    "listens": []
  },
  "dashboard": {
    "stats": [
      {
        "key": "total_favorites",
        "title": "总收藏数",
        "type": "counter"
      },
      {
        "key": "active_users",
        "title": "有收藏的用户数",
        "type": "counter"
      }
    ]
  },
  "settings_schema": {
    "type": "object",
    "properties": {
      "max_page_size": {
        "title": "最大分页大小",
        "type": "integer",
        "default": 50,
        "minimum": 1,
        "maximum": 200
      }
    }
  }
}
